  "definitions": {
    "families": "by file extension; pool = union of poi(test-data/{document,spreadsheet,slideshow,hsmf,diagram,publisher,hpsf,hmef}) + format-corpus + pdfjs(test/pdfs); sorted by corpus/path; index floor((i+0.5)*pool/30)",
    "exclusions": "name regex /fuzz|encrypt|passw|protect|crypt|clusterfuzz|crash-|poc-|saslprep|auth-event/i; pdf.js allowedNotOk basenames; zero-byte; >25 MiB",
    "contentType": "parameters stripped, lowercased, small alias table; if ripstream fails, ripstream.detect() type is used",
    "text": "whitespace collapsed, lowercased; tokens = runs of letters/digits; Jaccard on token sets; lenRatio = min/max of normalised lengths; top = record 0 only, all = all records concatenated; median/p10 over files where both sides succeeded and at least one side has text",
    "metadata": "fixed key list (see run.mjs FIXED_KEYS), top-level record only; equalPct and presentPct are over fixed keys Tika emits (Content-Type excluded); dates compared as instants, numbers numerically; verbatim = raw strings equal; equalOrAlias also accepts the same value under an equivalent ripstream key name",
    "embedded": "records.length - 1 on each side, equality of counts, only files where both succeeded",
    "failure": "tika failure = HTTP error/timeout or exception key on record 0; ripstream failure = thrown error or exception on record 0"
  },
