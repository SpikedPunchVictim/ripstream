  "k-midrun-crash-prod": { "allow": ["signal:SIGABRT"], "ready": true, "killedBy": null, "error": "LimitExceededError" },
  "l-production-xcpu": { "allow": ["signal:SIGXCPU"], "forbid": ["signal:SIGKILL"], "ready": true, "killedBy": null, "error": "LimitExceededError" },
  "n-close-vs-exit-grace-prod": { "allow": ["code:0"], "ready": true, "killedBy": null, "error": null },
  "w1-fail-closed-cpu-prod": { "allow": ["rejected-before-spawn"], "ready": false, "error": "TypeError" },
  "w2-fail-closed-vmem-prod": { "allow": ["rejected-before-spawn"], "ready": false, "error": "TypeError" },
