  "i-giant-frame-capped-prod": { "allow": ["signal:SIGKILL"], "ready": true, "killedBy": "frame_cap", "error": "LimitExceededError" },
  "j-done-linger-group-prod": { "allow": ["signal:SIGKILL"], "ready": true, "killedBy": "grace", "error": null },
  "k-no-shell-prod": { "allow": ["spawn:ENOENT"], "ready": false, "killedBy": null, "error": "IsolationError:unavailable" },
  "k-no-node-prod": { "allow": ["code:127"], "stderrAny": ["not found"], "ready": false, "killedBy": null, "error": "IsolationError:unavailable" },
