{
  "description": "tikajs-p1qx: expected values are what Tika 4.2.0 /rmeta returned for the same bytes. /P forbids everything but the owner password is empty, so the empty password opens it as owner and PDFBox grants every permission.",
  "tags": [
    "smoke",
    "pdf",
    "metadata"
  ],
  "input": {
    "base64": "",
    "filename": "pdf-metadata-access-permissions-empty-owner.pdf"
  },
  "assertions": [
    {
      "type": "equals",
      "field": "metadata.access-permission:can-print",
      "value": "true"
    },
    {
      "type": "equals",
      "field": "metadata.access-permission:can-print-faithful",
      "value": "true"
    },
    {
      "type": "equals",
      "field": "metadata.access-permission:can-modify",
      "value": "true"
    },
    {
      "type": "equals",
      "field": "metadata.access-permission:extract-content",
      "value": "true"
    },
    {
      "type": "equals",
      "field": "metadata.access-permission:extract-for-accessibility",
      "value": "true"
    },
    {
      "type": "equals",
      "field": "metadata.access-permission:fill-in-form",
      "value": "true"
    },
    {
      "type": "equals",
      "field": "metadata.access-permission:modify-annotations",
      "value": "true"
    },
    {
      "type": "equals",
      "field": "metadata.access-permission:assemble-document",
      "value": "true"
    }
  ]
}
