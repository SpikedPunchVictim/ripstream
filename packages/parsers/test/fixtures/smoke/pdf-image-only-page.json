{
  "description": "tikajs-bs8q: a one-page PDF whose page paints an image and shows no text, as a scan does. The result is ok with no text; tk:pdf:image-only-page-count and tk:pdf:image-only-pages (1-based) let the caller decide it needs OCR. Not repaired.",
  "tags": [
    "smoke",
    "pdf"
  ],
  "input": {
    "base64": "",
    "filename": "pdf-image-only-page.pdf"
  },
  "assertions": [
    {
      "type": "max_length",
      "field": "text",
      "value": 4
    },
    {
      "type": "equals",
      "field": "metadata.tk:pdf:image-only-page-count",
      "value": "1"
    },
    {
      "type": "equals",
      "field": "metadata.tk:pdf:image-only-pages",
      "value": "1"
    },
    {
      "type": "equals",
      "field": "metadata.pdf:chars-per-page",
      "value": "0"
    },
    {
      "type": "absent",
      "field": "metadata.tk:pdf:repaired"
    }
  ]
}
