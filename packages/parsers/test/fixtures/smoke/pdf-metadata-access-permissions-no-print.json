{
  "description": "tikajs-p1qx: expected values are what Tika 4.2.0 /rmeta returned for the same bytes. An RC4 file (revision 2) opened with the empty user password whose /P clears the print bit: can-print is false, the rest true.",
  "tags": [
    "smoke",
    "pdf",
    "metadata"
  ],
  "input": {
    "base64": "",
    "filename": "pdf-metadata-access-permissions-no-print.pdf"
  },
  "assertions": [
    {
      "type": "equals",
      "field": "metadata.access-permission:can-print",
      "value": "false"
    },
    {
      "type": "equals",
      "field": "metadata.access-permission:can-print-faithful",
      "value": "true"
    },
    {
      "type": "equals",
      "field": "metadata.access-permission:can-modify",
      "value": "true"
    },
    {
      "type": "equals",
      "field": "metadata.access-permission:extract-content",
      "value": "true"
    },
    {
      "type": "equals",
      "field": "metadata.access-permission:extract-for-accessibility",
      "value": "true"
    },
    {
      "type": "equals",
      "field": "metadata.access-permission:fill-in-form",
      "value": "true"
    },
    {
      "type": "equals",
      "field": "metadata.access-permission:modify-annotations",
      "value": "true"
    },
    {
      "type": "equals",
      "field": "metadata.access-permission:assemble-document",
      "value": "true"
    }
  ]
}
