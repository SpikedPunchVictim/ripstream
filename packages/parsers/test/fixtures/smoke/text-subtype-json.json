{
  "description": "a text subtype (JSON by filename) keeps its own type and gains the charset",
  "tags": ["smoke", "text"],
  "input": { "text": "{\"a\":1}", "filename": "data.json" },
  "assertions": [
    { "type": "equals", "field": "metadata.Content-Type", "value": "application/json; charset=windows-1252" }
  ]
}
