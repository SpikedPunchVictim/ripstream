{
  "description": "tikajs-u03v. Adapted from xberg (MIT) docx_moved_text.rs. Oracle Tika 4.2.0 /tika: the source of a tracked move (w:moveFrom, written with w:t) and deleted text (w:delText) are not written; the new place (w:moveTo) is, so the moved text appears once.",
  "tags": [
    "xberg",
    "docx",
    "ooxml"
  ],
  "input": {
    "base64": "",
    "filename": "a.docx"
  },
  "assertions": [
    {
      "type": "contains",
      "field": "text",
      "value": "New place: MOVED SENTENCE"
    },
    {
      "type": "not_contains",
      "field": "text",
      "value": "GONE"
    },
    {
      "type": "matches",
      "field": "text",
      "value": "^(?:(?!MOVED SENTENCE)[\\s\\S])*MOVED SENTENCE(?:(?!MOVED SENTENCE)[\\s\\S])*$"
    }
  ]
}
