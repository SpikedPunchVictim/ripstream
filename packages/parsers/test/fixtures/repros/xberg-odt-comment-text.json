{
  "description": "tikajs-u03v. Adapted from xberg (MIT) issue_odt_odf_extraction_defects.rs (issue 100). Oracle Tika 4.2.0 /tika: an office:annotation body is written as a block of its own, 'Please review this figure.' then '&#32;This needs revision. ' (Tika's literal '&#32;').",
  "tags": [
    "xberg",
    "odt",
    "odf"
  ],
  "input": {
    "base64": "",
    "filename": "a.odt"
  },
  "assertions": [
    {
      "type": "contains",
      "field": "text",
      "value": "Please review this figure."
    },
    {
      "type": "contains",
      "field": "text",
      "value": "This needs revision."
    }
  ]
}
