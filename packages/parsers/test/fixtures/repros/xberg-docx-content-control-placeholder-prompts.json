    {
      "type": "contains",
      "field": "text",
      "value": "City: Berlin"
    },
    {
      "type": "contains",
      "field": "text",
      "value": "Enter a summary here."
    },
    {
      "type": "contains",
      "field": "text",
      "value": "End."
    }
  ]
}
