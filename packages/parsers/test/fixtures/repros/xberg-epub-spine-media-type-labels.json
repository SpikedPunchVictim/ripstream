{
  "description": "tikajs-u03v. Adapted from xberg (MIT) EPUB edge cases (#1486). Oracle Tika 4.2.0 /rmeta: spine items labelled text/html, with parameters, or in upper case are chapters; an empty label is an embedded document (text still present); text/xml and application/xml items are neither read nor embedded (xberg expected all six).",
  "tags": [
    "xberg",
    "epub",
    "edge"
  ],
  "input": {
    "base64": "",
    "filename": "a.epub"
  },
  "assertions": [
    {
      "type": "contains",
      "field": "text",
      "value": "MEDIA-TYPE-TEXT-HTML"
    },
    {
      "type": "not_contains",
      "field": "text",
      "value": "MEDIA-TYPE-TEXT-XML"
    },
    {
      "type": "not_contains",
      "field": "text",
      "value": "MEDIA-TYPE-APPLICATION-XML"
    },
    {
      "type": "contains",
      "field": "text",
      "value": "MEDIA-TYPE-PARAMETERS"
    },
    {
      "type": "contains",
      "field": "text",
      "value": "MEDIA-TYPE-UPPERCASE"
    },
    {
      "type": "contains",
      "field": "text",
      "value": "MEDIA-TYPE-EMPTY"
    }
  ]
}
