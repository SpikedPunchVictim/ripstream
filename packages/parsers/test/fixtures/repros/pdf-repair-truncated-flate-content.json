{
  "description": "tikajs-4hfu: a Flate content stream cut part way (no endstream; the font and page follow, no xref or trailer). The readable start of the stream is kept (step stream-salvaged): the lines shown before the cut are recovered, the rest is lost.",
  "tags": [
    "repro",
    "pdf",
    "repair"
  ],
  "input": {
    "base64": "",
    "filename": "pdf-repair-truncated-flate-content.pdf"
  },
  "assertions": [
    {
      "type": "contains",
      "field": "text",
      "value": "Line 0 of a cut stream w0 w7919"
    },
    {
      "type": "not_contains",
      "field": "text",
      "value": "Line 39 of a cut stream"
    },
    {
      "type": "equals",
      "field": "metadata.tk:pdf:repaired",
      "value": "true"
    }
  ]
}
