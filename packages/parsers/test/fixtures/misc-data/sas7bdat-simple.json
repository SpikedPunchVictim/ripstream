{
  "description": "Tika's SAS7BDATParserTest.testSimpleFile and testHTML on testSAS.sas7bdat: the dataset is a table under its name, with the values the test asserts. The column names (a list) and the markup are asserted in sas7bdat.test.ts (tikajs-68os.21). Read from the Tika source, not run against a Tika; Tika reads the file with parso, whose source was not available",
  "tags": ["sas", "sas7bdat", "database"],
  "input": { "file": "testSAS.sas7bdat" },
  "assertions": [
    { "type": "equals", "field": "metadata.Content-Type", "value": "application/x-sas-data" },
    { "type": "equals", "field": "metadata.tk:parsed-by", "value": "SAS7BDATParser" },
    { "type": "equals", "field": "metadata.dc:title", "value": "TESTING" },
    { "type": "equals", "field": "metadata.dcterms:created", "value": "2017-01-30T07:31:47Z" },
    { "type": "equals", "field": "metadata.dcterms:modified", "value": "2017-01-30T07:31:47Z" },
    { "type": "equals", "field": "metadata.xmpTPg:NPages", "value": "1" },
    { "type": "equals", "field": "metadata.database:column-count", "value": "2" },
    { "type": "equals", "field": "metadata.database:row-count", "value": "11" },
    { "type": "equals", "field": "metadata.Content-Encoding", "value": "windows-1252" },
    { "type": "equals", "field": "metadata.extended-properties:Application", "value": "W32_7PRO" },
    { "type": "equals", "field": "metadata.extended-properties:AppVersion", "value": "9.0301M2" },
    { "type": "equals", "field": "metadata.machine:architectureBits", "value": "32" },
    { "type": "equals", "field": "metadata.machine:endian", "value": "Little" },
    { "type": "contains", "field": "text", "value": "TESTING" },
    { "type": "contains", "field": "text", "value": "\t3\t" },
    { "type": "contains", "field": "text", "value": "\t10\t" },
    { "type": "contains", "field": "text", "value": "\tThis is row" },
    { "type": "contains", "field": "text", "value": " of " }
  ]
}
