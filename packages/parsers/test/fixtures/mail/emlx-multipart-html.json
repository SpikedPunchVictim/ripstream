{
  "description": "EMLXTest.testLongHeaderBlockWithHtmlAlternative on testEMLX_multipart_html.emlx: the HTML alternative is the body, the sender's address and the UTC date are written. Read from the Tika source, not run against a Tika (tikajs-68os.46).",
  "tags": [
    "mail",
    "rfc822"
  ],
  "input": {
    "file": "testEMLX_multipart_html.emlx",
    "filename": "testEMLX_multipart_html.emlx"
  },
  "assertions": [
    {
      "type": "equals",
      "field": "metadata.Content-Type",
      "value": "message/x-emlx"
    },
    {
      "type": "equals",
      "field": "metadata.dc:title",
      "value": "Set the Foundation Straight"
    },
    {
      "type": "equals",
      "field": "metadata.message:from-email",
      "value": "hseldon@example.com"
    },
    {
      "type": "equals",
      "field": "metadata.dcterms:created",
      "value": "2015-09-26T16:30:20Z"
    },
    {
      "type": "contains",
      "field": "text",
      "value": "The plan for the Foundation is in this message’s HTML part."
    },
    {
      "type": "not_contains",
      "field": "text",
      "value": "date-received"
    }
  ]
}
