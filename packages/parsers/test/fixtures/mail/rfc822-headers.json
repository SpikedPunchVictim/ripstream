{
  "description": "RFC822ParserTest.testExtendedToFromMetadata and testSimple on testRFC822: the sender's name and address, the creator and subject, the date in UTC, and every other header as a raw header. Read from the Tika source, not run against a Tika (tikajs-68os.46).",
  "tags": [
    "mail",
    "rfc822"
  ],
  "input": {
    "file": "testRFC822",
    "filename": "testRFC822"
  },
  "options": {
    "contentType": "message/rfc822"
  },
  "assertions": [
    {
      "type": "equals",
      "field": "metadata.message:from-name",
      "value": "Julien Nioche (JIRA)"
    },
    {
      "type": "equals",
      "field": "metadata.message:from-email",
      "value": "jira@apache.org"
    },
    {
      "type": "equals",
      "field": "metadata.message:from",
      "value": "Julien Nioche (JIRA) <jira@apache.org>"
    },
    {
      "type": "equals",
      "field": "metadata.dc:creator",
      "value": "Julien Nioche (JIRA) <jira@apache.org>"
    },
    {
      "type": "equals",
      "field": "metadata.message:to",
      "value": "dev@tika.apache.org"
    },
    {
      "type": "equals",
      "field": "metadata.dc:title",
      "value": "[jira] Commented: (TIKA-461) RFC822 messages not parsed"
    },
    {
      "type": "equals",
      "field": "metadata.dc:subject",
      "value": "[jira] Commented: (TIKA-461) RFC822 messages not parsed"
    },
    {
      "type": "equals",
      "field": "metadata.tk:resource-name",
      "value": "[jira] Commented: (TIKA-461) RFC822 messages not parsed.eml"
    },
    {
      "type": "equals",
      "field": "metadata.dcterms:created",
      "value": "2010-09-06T09:25:34Z"
    },
    {
      "type": "equals",
      "field": "metadata.message:raw-header:Reply-To",
      "value": "dev@tika.apache.org"
    },
    {
      "type": "equals",
      "field": "metadata.message:raw-header:MIME-Version",
      "value": "1.0"
    },
    {
      "type": "equals",
      "field": "metadata.message:raw-header:Content-Type",
      "value": "text/plain; charset=utf-8"
    },
    {
      "type": "equals",
      "field": "metadata.message:raw-header:X-JIRA-FingerPrint",
      "value": "30527f35849b9dde25b450d4833f0394"
    },
    {
      "type": "absent",
      "field": "metadata.message:raw-header:Subject"
    },
    {
      "type": "absent",
      "field": "metadata.message:raw-header:From"
    },
    {
      "type": "absent",
      "field": "metadata.message:raw-header:Date"
    },
    {
      "type": "absent",
      "field": "metadata.Message:From"
    },
    {
      "type": "absent",
      "field": "metadata.Message-ID"
    }
  ]
}
