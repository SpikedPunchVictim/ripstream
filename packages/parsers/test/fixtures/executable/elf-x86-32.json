{
  "description": "Tika's testLinux-x86-32: ExecutableParserTest.testElfParser_x86_32 asserts these values; its platform assertion is commented out, and the OS ABI bytes are 0 so none is set (tikajs-68os.17)",
  "tags": ["executable", "elf"],
  "input": { "file": "testLinux-x86-32" },
  "assertions": [
    { "type": "equals", "field": "metadata.Content-Type", "value": "application/x-executable" },
    { "type": "equals", "field": "metadata.machine:machineType", "value": "x86-32" },
    { "type": "equals", "field": "metadata.machine:endian", "value": "Little" },
    { "type": "equals", "field": "metadata.machine:architectureBits", "value": "32" },
    { "type": "absent", "field": "metadata.machine:platform" },
    { "type": "equals", "field": "text", "value": "" }
  ]
}
