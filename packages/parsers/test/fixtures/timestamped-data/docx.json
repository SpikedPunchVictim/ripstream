{
  "description": "Tika's TSDParserTest on Test3.docx.tsd: the stamped Word document is parsed as the embedded document (tikajs-68os.21). Read from the Tika source, not run against a Tika",
  "tags": [
    "tsd",
    "timestamped-data",
    "cms"
  ],
  "input": {
    "file": "Test3.docx.tsd",
    "filename": "Test3.docx.tsd"
  },
  "assertions": [
    {
      "type": "equals",
      "field": "metadata.Content-Type",
      "value": "application/timestamped-data"
    },
    {
      "type": "equals",
      "field": "metadata.tk:parsed-by",
      "value": "TSDParser"
    },
    {
      "type": "contains",
      "field": "text",
      "value": "Empty doc"
    }
  ]
}
