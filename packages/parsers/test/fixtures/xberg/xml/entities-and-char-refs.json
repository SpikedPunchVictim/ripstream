{
  "description": "Adapted from xberg (MIT) crates/xberg/tests/issue_1242_xml_entities.rs: &amp; &lt; &gt; and numeric references survive in text.",
  "tags": [
    "xberg",
    "xml"
  ],
  "input": {
    "text": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<root><item>Cats &amp; Dogs &lt;tag&gt; 5&gt;3 em&#8212;dash hex&#x2014;dash</item></root>",
