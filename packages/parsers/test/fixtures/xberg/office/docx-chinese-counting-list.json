{
  "description": "Adapted from xberg (MIT) crates/xberg/tests/docx_numbered_list_formats.rs: a list numbered one-two-three in Chinese counting keeps its item text.",
  "tags": [
    "xberg",
    "docx",
    "ooxml"
  ],
  "input": {
    "base64": "",
    "filename": "a.docx"
  },
  "assertions": [
    {
      "type": "contains",
      "field": "text",
      "value": "第一项"
    },
    {
      "type": "contains",
      "field": "text",
      "value": "第二项"
    },
    {
      "type": "contains",
      "field": "text",
      "value": "第三项"
    }
  ]
}
