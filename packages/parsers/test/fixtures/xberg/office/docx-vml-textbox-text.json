{
  "description": "Adapted from xberg (MIT) crates/xberg/tests/docx_content_control_placeholders.rs (text box shapes): text inside a VML text box is extracted.",
  "tags": [
    "xberg",
    "docx",
    "ooxml"
  ],
  "input": {
    "base64": "",
    "filename": "a.docx"
  },
  "assertions": [
    {
      "type": "contains",
      "field": "text",
      "value": "Lead."
    },
    {
      "type": "contains",
      "field": "text",
      "value": "BOX TEXT"
    }
  ]
}
