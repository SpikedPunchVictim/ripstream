{
  "description": "Adapted from xberg (MIT) crates/xberg/tests/docx_relationship_traversal.rs: an image relationship whose Target is 'https://example.invalid/x.png' does not break extraction of the surrounding text.",
  "tags": [
    "xberg",
    "docx",
    "ooxml"
  ],
  "input": {
    "base64": "",
    "filename": "a.docx"
  },
  "assertions": [
    {
      "type": "contains",
      "field": "text",
      "value": "Before image."
    },
    {
      "type": "contains",
      "field": "text",
      "value": "After image."
    }
  ]
}
