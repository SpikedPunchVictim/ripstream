{
  "description": "Adapted from xberg (MIT) td/EPUB_EDGE_CASES.md + crates/xberg/tests/epub_hardening_tests.rs: a spine item whose href is a remote URL does not hide the local chapter (#1491).",
  "tags": [
    "xberg",
    "epub",
    "edge"
  ],
  "input": {
    "base64": "",
    "filename": "a.epub"
  },
  "assertions": [
    {
      "type": "contains",
      "field": "text",
      "value": "LOCAL-CHAPTER"
    }
  ]
}
