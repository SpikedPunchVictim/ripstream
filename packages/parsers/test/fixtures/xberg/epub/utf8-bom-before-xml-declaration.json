{
  "description": "Adapted from xberg (MIT) td/EPUB_EDGE_CASES.md + crates/xberg/tests/epub_hardening_tests.rs: a UTF-8 BOM before <?xml in a chapter is not printed as prose (#1488).",
  "tags": [
    "xberg",
    "epub",
    "edge"
  ],
  "input": {
    "base64": "",
    "filename": "a.epub"
  },
  "assertions": [
    {
      "type": "contains",
      "field": "text",
      "value": "BOM chapter text"
    },
    {
      "type": "not_contains",
      "field": "text",
      "value": "?xml"
    },
    {
      "type": "not_contains",
      "field": "text",
      "value": "﻿"
    }
  ]
}
