{
  "description": "Adapted from xberg (MIT) crates/xberg/src/extraction/email/base64_tests.rs: a text attachment labelled base64 that holds plain words.",
  "tags": [
    "xberg",
    "mail",
    "rfc822"
  ],
  "input": {
    "base64": "",
    "filename": "a.eml"
  },
  "options": {
    "contentType": "message/rfc822"
  },
  "assertions": [
    {
      "type": "contains",
      "field": "text",
      "value": "See the note."
    }
  ]
}
