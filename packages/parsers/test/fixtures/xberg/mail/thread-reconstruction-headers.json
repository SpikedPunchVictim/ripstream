{
  "description": "Adapted from xberg (MIT) crates/xberg/tests/issue_169_email_extra_headers.rs: Reply-To, Message-ID, In-Reply-To, References, List-Id, List-Unsubscribe all reach metadata.",
  "tags": [
    "xberg",
    "mail",
    "rfc822"
  ],
  "input": {
    "base64": "",
    "filename": "a.eml"
  },
  "options": {
    "contentType": "message/rfc822"
  },
  "assertions": [
    {
      "type": "contains",
      "field": "text",
      "value": "Body text."
    },
    {
      "type": "equals",
      "field": "metadata.message:raw-header:Reply-To",
      "value": "reply@example.com"
    },
    {
      "type": "equals",
      "field": "metadata.message:raw-header:Message-ID",
      "value": "<msg1@example.com>"
    },
    {
      "type": "equals",
      "field": "metadata.message:raw-header:In-Reply-To",
      "value": "<parent@example.com>"
    },
    {
      "type": "equals",
      "field": "metadata.message:raw-header:References",
      "value": "<root@example.com> <parent@example.com>"
    },
    {
      "type": "equals",
      "field": "metadata.message:raw-header:List-Id",
      "value": "engineering <eng.example.com>"
    },
    {
      "type": "equals",
      "field": "metadata.message:raw-header:List-Unsubscribe",
      "value": "<mailto:unsub@example.com>"
    },
    {
      "type": "equals",
      "field": "metadata.message:cc",
      "value": "cc@example.com"
    }
  ]
}
