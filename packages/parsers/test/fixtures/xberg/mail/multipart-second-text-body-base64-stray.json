{
  "description": "Adapted from xberg (MIT) crates/xberg/src/extraction/email/base64_tests.rs: each text body is recovered from its own part.",
  "tags": [
    "xberg",
    "mail",
    "rfc822"
  ],
  "input": {
    "base64": "",
    "filename": "a.eml"
  },
  "options": {
    "contentType": "message/rfc822"
  },
  "assertions": [
    {
      "type": "equals",
      "field": "text",
      "value": "Subject: Figures\nFrom: alice@example.com\n\nIntro.\n\nWorld"
    }
  ]
}
