      "value": "Circuit"
    },
    {
      "type": "contains",
      "field": "text",
      "value": "101"
    },
    {
      "type": "contains",
      "field": "text",
      "value": "40A"
    },
    {
      "type": "contains",
      "field": "text",
      "value": "Blower"
    }
  ]
