{
  "description": "Adapted from xberg (MIT) crates/xberg/tests/text_formats_utf8_bom.rs: a UTF-8 BOM in front of rst does not leak into the text.",
  "tags": [
    "xberg",
    "text",
    "encoding",
    "bom"
  ],
  "input": {
    "base64": "77u/VGl0bGUKPT09PT0KCkJvZHkgdGV4dC4K",
    "filename": "a.rst"
  },
  "assertions": [
    {
      "type": "not_contains",
      "field": "text",
      "value": "﻿"
    },
    {
      "type": "contains",
      "field": "text",
      "value": "Title"
    },
    {
      "type": "contains",
      "field": "text",
      "value": "Body text."
    }
  ]
}
