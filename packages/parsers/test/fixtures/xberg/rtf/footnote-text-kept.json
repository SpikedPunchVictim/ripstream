{
  "description": "Adapted from xberg (MIT) crates/xberg/src/extractors/rtf/parser/text_extract_lint_tests.rs: footnote text is extracted.",
  "tags": [
    "xberg",
    "rtf"
  ],
  "input": {
    "text": "{\\rtf1\\pard A{\\footnote Note}{\\shptxt Box}{\\annotation{\\*\\atnid7}Comment}}",
    "filename": "a.rtf"
  },
  "options": {
    "contentType": "application/rtf"
  },
  "assertions": [
    {
      "type": "contains",
      "field": "text",
      "value": "Note"
    },
    {
      "type": "contains",
      "field": "text",
      "value": "Box"
    },
    {
      "type": "contains",
      "field": "text",
      "value": "Comment"
    }
  ]
}
