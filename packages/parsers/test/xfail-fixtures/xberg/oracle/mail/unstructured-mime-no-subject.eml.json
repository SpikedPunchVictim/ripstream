{
  "description": "[xfail tikajs-w12u] Tika 4.2.0 oracle (PUT /rmeta/body, filename mime-no-subject.eml) text and Content-Type for test_documents/vendored/unstructured/eml/mime-no-subject.eml from the xberg corpus (unstructured, Apache-2.0); bead tikajs-qw7f.",
  "tags": [
    "xberg",
    "oracle",
    "mail",
    "xfail"
  ],
  "input": {
    "file": "../files/unstructured-mime-no-subject.eml",
    "filename": "mime-no-subject.eml"
  },
  "assertions": [
    {
      "type": "equals",
      "field": "metadata.Content-Type",
      "value": "message/rfc822"
    },
    {
      "type": "equals",
      "field": "text",
      "value": "This is a simple email message without a subject.\n\n\n"
    },
    {
      "type": "equals",
      "field": "metadata.dc:creator",
      "value": "sender@example.com"
    },
    {
      "type": "equals",
      "field": "metadata.message:from",
      "value": "sender@example.com"
    },
    {
      "type": "equals",
      "field": "metadata.message:to",
      "value": "recipient@example.com"
    },
    {
      "type": "equals",
      "field": "metadata.message:from-email",
      "value": "sender@example.com"
    }
  ]
}
